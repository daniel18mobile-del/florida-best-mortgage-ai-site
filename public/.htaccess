Options -MultiViews
RewriteEngine On

# Keep every request on the canonical hostname so links, crawl signals, and
# analytics are consolidated on https://floridabestmortgage.com.
RewriteCond %{HTTP_HOST} ^www\.floridabestmortgage\.com$ [NC]
RewriteRule ^ https://floridabestmortgage.com%{REQUEST_URI} [R=301,L,NE]
